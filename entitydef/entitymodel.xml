<entitymodel xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/entitymodel.xsd">
    <!-- ========================================================= -->
    <!-- ======================== Defaults ======================= -->
    <!-- ========================================================= -->
    <title>Entity of Bfcommon Component</title>
    <description>None</description>
    <copyright></copyright>
    <version></version>


    <entity entity-name="Chat" package-name="com.banfftech.common" title="Chat">
        <field name="chatId" type="id"><description>主键</description></field>
        <field name="workEffortId" type="id"><description>关联会话</description></field>
        <field name="msgStatus" type="id"><description>当前会话状态</description></field>
        <prim-key field="chatId"/>
        <relation type="one" fk-name="CHAT_TO_WORK_EFFORT" rel-entity-name="WorkEffort">
            <key-map field-name="workEffortId"/>
        </relation>
        <relation type="many" fk-name="CHAT_CHAT_PARTY" rel-entity-name="ChatParty">
            <key-map field-name="chatId"/>
        </relation>
    </entity>

    <entity entity-name="ChatParty" package-name="com.banfftech.common" title="Chat Assoc Party">
        <field name="chatId" type="id"><description>会话主键</description></field>
        <field name="partyId" type="id"><description>party主键</description></field>
        <field name="roleTypeId" type="id"><description>party角色类型</description></field>
        <prim-key field="chatId"/>
        <prim-key field="partyId"/>
        <relation type="one" fk-name="ASSOC_TO_CHAT" rel-entity-name="Chat">
            <key-map field-name="chatId"/>
        </relation>
        <relation type="one" fk-name="ASSOC_TO_PARTY" rel-entity-name="Party">
            <key-map field-name="partyId"/>
        </relation>
        <relation type="one" fk-name="ASSOC_TO_PARTY_ROLE" rel-entity-name="RoleType">
            <key-map field-name="roleTypeId"/>
        </relation>
    </entity>

    <entity entity-name="ChatMessage" package-name="com.banfftech.common" title="Chat info">
        <field name="chatId" type="id"><description>主键</description></field>
        <field name="sequence" type="numeric"><description>序号主键</description></field>
        <field name="messageTypeId" type="id"><description>消息类型</description></field>
        <field name="messageInfo" type="very-long"><description>消息内容</description></field>
        <field name="fromPartyId" type="id"><description>消息发出人</description></field>
        <prim-key field="chatId"/>
        <prim-key field="sequence"/>
        <relation type="one" fk-name="MSG_TO_CHAT" rel-entity-name="Chat">
            <key-map field-name="chatId"/>
        </relation>
        <relation type="one" fk-name="CHAT_MSG_PARTY" rel-entity-name="Party">
            <key-map field-name="fromPartyId" rel-field-name="partyId"/>
        </relation>
        <relation type="one" fk-name="CHAT_TYPE" rel-entity-name="ChatMessageType">
            <key-map field-name="messageTypeId"/>
        </relation>
    </entity>

    <entity entity-name="ChatMessageType" package-name="com.banfftech.common" title="Chat Type">
        <field name="messageTypeId" type="id"><description>消息类型标识</description></field>
        <field name="description" type="value"><description>类型描述</description></field>
        <prim-key field="messageTypeId"/>
    </entity>

    <!-- DataResouceElectornicOther is for Person and PartyGroup which has Party as Base Type -->
    <view-entity entity-name="DataResouceElectornicOther" package-name="com.dpbird.odata">
        <member-entity entity-alias="D" entity-name="DataResource"/>
        <member-entity entity-alias="E" entity-name="ElectronicText"/>
        <member-entity entity-alias="O" entity-name="OtherDataResource"/>
        <alias-all entity-alias="D"/>
        <alias-all entity-alias="E"/>
        <alias-all entity-alias="O"/>
        <view-link rel-entity-alias="E" entity-alias="D" rel-optional="true">
            <key-map field-name="dataResourceId"/>
        </view-link>
        <view-link rel-entity-alias="O" entity-alias="D" rel-optional="true">
            <key-map field-name="dataResourceId"/>
        </view-link>
        <relation type="one-nofk" rel-entity-name="ElectronicText">
            <key-map field-name="dataResourceId"/>
        </relation>
        <relation type="one-nofk" rel-entity-name="OtherDataResource">
            <key-map field-name="dataResourceId"/>
        </relation>
    </view-entity>

    <!-- Party and TelecomNumber and PostalAddress -->
    <view-entity entity-name="PartyAndContact"
                 package-name="com.banfftech.common"
                 never-cache="true">
        <member-entity entity-alias="PTY" entity-name="Party"/>
        <member-entity entity-alias="PER" entity-name="Person"/>
        <member-entity entity-alias="PPPH" entity-name="PartyContactMechPurpose"/><!-- PRIMARY_PHONE -->
        <member-entity entity-alias="PPHM" entity-name="PartyContactMechPurpose"/><!-- PHONE_MOBILE -->
        <member-entity entity-alias="PPE" entity-name="PartyContactMechPurpose"/><!-- PRIMARY_EMAIL -->
        <member-entity entity-alias="PPL" entity-name="PartyContactMechPurpose"/><!-- PRIMARY_LOCATION -->
        <member-entity entity-alias="TPPH" entity-name="TelecomNumber"/><!-- primary phone number -->
        <member-entity entity-alias="TPHM" entity-name="TelecomNumber"/><!-- mobile phone number -->
        <member-entity entity-alias="PAPL" entity-name="PostalAddress"/><!-- primary location -->
        <member-entity entity-alias="CPE" entity-name="ContactMech"/><!-- email -->
        <alias-all entity-alias="PTY" group-by="true"/>
        <alias-all entity-alias="PER" group-by="true">
            <exclude field="partyId"/>
        </alias-all>
        <alias name="primaryPhone" field="contactNumber" entity-alias="TPPH" group-by="true"/>
        <alias name="phoneMobile" field="contactNumber" entity-alias="TPHM" group-by="true"/>
        <alias name="primaryEmail" field="infoString" entity-alias="CPE" group-by="true"/>
        <alias name="address1" field="address1" entity-alias="PAPL" group-by="true"/>
        <alias name="address2" field="address2" entity-alias="PAPL" group-by="true"/>
        <alias name="city" field="city" entity-alias="PAPL" group-by="true"/>
        <view-link entity-alias="PTY" rel-entity-alias="PER" rel-optional="true"><!-- primary phone number -->
            <key-map field-name="partyId"/>
        </view-link>
        <view-link entity-alias="PTY" rel-entity-alias="PPPH" rel-optional="true"><!-- primary phone number -->
            <key-map field-name="partyId"/>
            <entity-condition>
                <condition-expr entity-alias="PPPH" field-name="contactMechPurposeTypeId" value="PRIMARY_PHONE"/>
            </entity-condition>
        </view-link>
        <view-link entity-alias="PTY" rel-entity-alias="PPHM" rel-optional="true"><!-- mobile phone number -->
            <key-map field-name="partyId"/>
            <entity-condition>
                <condition-expr entity-alias="PPHM" field-name="contactMechPurposeTypeId" value="PHONE_MOBILE"/>
            </entity-condition>
        </view-link>
        <view-link entity-alias="PTY" rel-entity-alias="PPE" rel-optional="true"><!-- email -->
            <key-map field-name="partyId"/>
            <entity-condition>
                <condition-expr entity-alias="PPE" field-name="contactMechPurposeTypeId" value="PRIMARY_EMAIL"/>
            </entity-condition>
        </view-link>
        <view-link entity-alias="PTY" rel-entity-alias="PPL" rel-optional="true"><!-- primary location -->
            <key-map field-name="partyId"/>
            <entity-condition>
                <condition-expr entity-alias="PPL" field-name="contactMechPurposeTypeId" value="PRIMARY_LOCATION"/>
            </entity-condition>
        </view-link>
        <view-link entity-alias="PPPH" rel-entity-alias="TPPH" rel-optional="true"><!-- primary phone number -->
            <key-map field-name="contactMechId"/>
        </view-link>
        <view-link entity-alias="PPHM" rel-entity-alias="TPHM" rel-optional="true"><!-- mobile phone number -->
            <key-map field-name="contactMechId"/>
        </view-link>
        <view-link entity-alias="PPE" rel-entity-alias="CPE" rel-optional="true"><!-- email -->
            <key-map field-name="contactMechId"/>
            <entity-condition>
                <condition-expr entity-alias="CPE" field-name="contactMechTypeId" value="EMAIL_ADDRESS"/>
            </entity-condition>
        </view-link>
        <view-link entity-alias="PPL" rel-entity-alias="PAPL" rel-optional="true"><!-- primary location -->
            <key-map field-name="contactMechId"/>
        </view-link>
<!--        <relation type="one-nofk" rel-entity-name="Person">-->
<!--            <key-map field-name="partyId"/>-->
<!--        </relation>-->
        <relation type="one-nofk" rel-entity-name="PartyGroup">
            <key-map field-name="partyId"/>
        </relation>
        <relation type="many" rel-entity-name="PartyRole">
            <key-map field-name="partyId"/>
        </relation>
        <relation type="many" rel-entity-name="UserLogin">
            <key-map field-name="partyId"/>
        </relation>
        <relation type="many" title="From" rel-entity-name="PartyRelationship">
            <key-map field-name="partyId" rel-field-name="partyIdFrom"/>
        </relation>
        <relation type="many" title="To" rel-entity-name="PartyRelationship">
            <key-map field-name="partyId" rel-field-name="partyIdTo"/>
        </relation>
        <relation type="one-nofk" rel-entity-name="StatusItem">
            <key-map field-name="statusId"/>
        </relation>
    </view-entity>

    <!-- UserLogin and Party and TelecomNumber and PostalAddress -->
    <view-entity entity-name="UserLoginAndContact"
                 package-name="com.banfftech.common"
                 never-cache="true">
        <member-entity entity-alias="UL" entity-name="UserLogin"/>
        <member-entity entity-alias="PTY" entity-name="Party"/>
        <member-entity entity-alias="PPPH" entity-name="PartyContactMechPurpose"/><!-- PRIMARY_PHONE -->
        <member-entity entity-alias="PPHM" entity-name="PartyContactMechPurpose"/><!-- PHONE_MOBILE -->
        <member-entity entity-alias="PPE" entity-name="PartyContactMechPurpose"/><!-- PRIMARY_EMAIL -->
        <member-entity entity-alias="PPL" entity-name="PartyContactMechPurpose"/><!-- PRIMARY_LOCATION -->
        <member-entity entity-alias="TPPH" entity-name="TelecomNumber"/><!-- primary phone number -->
        <member-entity entity-alias="TPHM" entity-name="TelecomNumber"/><!-- mobile phone number -->
        <member-entity entity-alias="PAPL" entity-name="PostalAddress"/><!-- primary location -->
        <member-entity entity-alias="CPE" entity-name="ContactMech"/><!-- email -->
        <alias-all entity-alias="UL" group-by="true"/>
        <alias-all entity-alias="PTY" group-by="true"/>
        <alias name="primaryPhone" field="contactNumber" entity-alias="TPPH" group-by="true"/>
        <alias name="phoneMobile" field="contactNumber" entity-alias="TPHM" group-by="true"/>
        <alias name="primaryEmail" field="infoString" entity-alias="CPE" group-by="true"/>
        <alias name="address1" field="address1" entity-alias="PAPL" group-by="true"/>
        <alias name="address2" field="address2" entity-alias="PAPL" group-by="true"/>
        <alias name="city" field="city" entity-alias="PAPL" group-by="true"/>
        <view-link entity-alias="UL" rel-entity-alias="PTY" rel-optional="true">
            <key-map field-name="partyId"/>
        </view-link>
        <view-link entity-alias="PTY" rel-entity-alias="PPPH" rel-optional="true"><!-- primary phone number -->
            <key-map field-name="partyId"/>
            <entity-condition>
                <condition-expr entity-alias="PPPH" field-name="contactMechPurposeTypeId" value="PRIMARY_PHONE"/>
            </entity-condition>
        </view-link>
        <view-link entity-alias="PTY" rel-entity-alias="PPHM" rel-optional="true"><!-- mobile phone number -->
            <key-map field-name="partyId"/>
            <entity-condition>
                <condition-expr entity-alias="PPHM" field-name="contactMechPurposeTypeId" value="PHONE_MOBILE"/>
            </entity-condition>
        </view-link>
        <view-link entity-alias="PTY" rel-entity-alias="PPE" rel-optional="true"><!-- email -->
            <key-map field-name="partyId"/>
            <entity-condition>
                <condition-expr entity-alias="PPE" field-name="contactMechPurposeTypeId" value="PRIMARY_EMAIL"/>
            </entity-condition>
        </view-link>
        <view-link entity-alias="PTY" rel-entity-alias="PPL" rel-optional="true"><!-- primary location -->
            <key-map field-name="partyId"/>
            <entity-condition>
                <condition-expr entity-alias="PPL" field-name="contactMechPurposeTypeId" value="PRIMARY_LOCATION"/>
            </entity-condition>
        </view-link>
        <view-link entity-alias="PPPH" rel-entity-alias="TPPH" rel-optional="true"><!-- primary phone number -->
            <key-map field-name="contactMechId"/>
        </view-link>
        <view-link entity-alias="PPHM" rel-entity-alias="TPHM" rel-optional="true"><!-- mobile phone number -->
            <key-map field-name="contactMechId"/>
        </view-link>
        <view-link entity-alias="PPE" rel-entity-alias="CPE" rel-optional="true"><!-- email -->
            <key-map field-name="contactMechId"/>
            <entity-condition>
                <condition-expr entity-alias="CPE" field-name="contactMechTypeId" value="EMAIL_ADDRESS"/>
            </entity-condition>
        </view-link>
        <view-link entity-alias="PPL" rel-entity-alias="PAPL" rel-optional="true"><!-- primary location -->
            <key-map field-name="contactMechId"/>
        </view-link>
        <relation type="one-nofk" rel-entity-name="PartyGroup">
            <key-map field-name="partyId"/>
        </relation>
        <relation type="many" rel-entity-name="PartyRole">
            <key-map field-name="partyId"/>
        </relation>
        <relation type="many" rel-entity-name="UserLogin">
            <key-map field-name="partyId"/>
        </relation>
        <relation type="many" title="From" rel-entity-name="PartyRelationship">
            <key-map field-name="partyId" rel-field-name="partyIdFrom"/>
        </relation>
        <relation type="many" title="To" rel-entity-name="PartyRelationship">
            <key-map field-name="partyId" rel-field-name="partyIdTo"/>
        </relation>
    </view-entity>


    <view-entity entity-name="ContentAndMediaDataResource"
                 package-name="org.apache.ofbiz.content.content"
                 title="Content and DataResource View Entity">
        <member-entity entity-alias="CO" entity-name="Content"/>
        <member-entity entity-alias="DR" entity-name="DataResource"/>
        <member-entity entity-alias="IDR" entity-name="ImageDataResource"/>
        <member-entity entity-alias="VDR" entity-name="VideoDataResource"/>
        <member-entity entity-alias="ADR" entity-name="AudioDataResource"/>
        <member-entity entity-alias="ODR" entity-name="OtherDataResource"/>
        <alias-all entity-alias="CO">
            <exclude field="mimeTypeId"/>
        </alias-all>
        <alias-all entity-alias="DR"/>
        <alias name="imageData" entity-alias="IDR" field="imageData"/>
        <alias name="videoData" entity-alias="VDR" field="videoData"/>
        <alias name="audioData" entity-alias="ADR" field="audioData"/>
        <alias name="otherData" entity-alias="ODR" field="otherData"/>
        <view-link entity-alias="CO" rel-entity-alias="DR" >
            <key-map field-name="dataResourceId"/>
        </view-link>
        <view-link entity-alias="DR" rel-entity-alias="IDR" rel-optional="true">
            <key-map field-name="dataResourceId"/>
        </view-link>
        <view-link entity-alias="DR" rel-entity-alias="VDR" rel-optional="true">
            <key-map field-name="dataResourceId"/>
        </view-link>
        <view-link entity-alias="DR" rel-entity-alias="ADR" rel-optional="true">
            <key-map field-name="dataResourceId"/>
        </view-link>
        <view-link entity-alias="DR" rel-entity-alias="ODR" rel-optional="true">
            <key-map field-name="dataResourceId"/>
        </view-link>
        <relation type="many" rel-entity-name="ContentRole">
            <key-map field-name="contentId"/>
        </relation>
    </view-entity>

    <view-entity entity-name="MemberProductCategory"
                 package-name="org.apache.ofbiz.product.category"
                 title="ProductCategory And ProductCategoryMember View Entity">
        <member-entity entity-alias="PCM" entity-name="ProductCategoryMember"/>
        <member-entity entity-alias="PC" entity-name="ProductCategory"/>
        <alias-all entity-alias="PCM"/>
        <alias-all entity-alias="PC">
            <exclude field="productCategoryId"/>
        </alias-all>
        <view-link entity-alias="PC" rel-entity-alias="PCM" >
            <key-map field-name="productCategoryId"/>
        </view-link>
        <relation type="one-nofk" rel-entity-name="ProductCategory">
            <key-map field-name="productCategoryId"/>
        </relation>
        <relation type="one-nofk" rel-entity-name="Product">
            <key-map field-name="productId"/>
        </relation>
    </view-entity>

    <entity entity-name="RoleTypeSecurityPermission" package-name="com.banfftech.common" title="RoleType SecurityPermission">
        <field name="roleTypeId" type="id"><description>角色主键</description></field>
        <field name="permissionId" type="id"><description>权限主键</description></field>
        <prim-key field="roleTypeId"/>
        <prim-key field="permissionId"/>
        <relation type="one" fk-name="RT_PERM_PERM" rel-entity-name="SecurityPermission">
            <key-map field-name="permissionId"/>
        </relation>
        <relation type="one" fk-name="RT_PERM_RT" rel-entity-name="RoleType">
            <key-map field-name="roleTypeId"/>
        </relation>
    </entity>

    <entity entity-name="RoleTypeUILabApp" package-name="com.banfftech.common" title="RoleType UILabApp">
        <field name="roleTypeUILabAppId" type="id"><description>主键</description></field>
        <field name="roleTypeId" type="id"><description>角色主键</description></field>
        <field name="uiLabAppId" type="id"><description>应用主键</description></field>
        <prim-key field="roleTypeUILabAppId"/>
        <relation type="one" fk-name="RT_UL_UL" rel-entity-name="UILabApp">
            <key-map field-name="uiLabAppId"/>
        </relation>
        <relation type="one" fk-name="RT_PERM_RT" rel-entity-name="RoleType">
            <key-map field-name="roleTypeId"/>
        </relation>
    </entity>

    <entity entity-name="RoleTypeSecurityGroup" package-name="com.banfftech.common" title="RoleType RoleTypeSecurityGroup">
        <field name="roleTypeId" type="id"><description>角色主键</description></field>
        <field name="groupId" type="id"><description>安全组主键</description></field>
        <prim-key field="roleTypeId"/>
        <prim-key field="groupId"/>
        <relation type="one" fk-name="RT_SG_GRO" rel-entity-name="SecurityGroup">
            <key-map field-name="groupId"/>
        </relation>
        <relation type="one" fk-name="RT_SG_RT" rel-entity-name="RoleType">
            <key-map field-name="roleTypeId"/>
        </relation>
    </entity>

</entitymodel>