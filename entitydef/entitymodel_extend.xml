<?xml version="1.0" encoding="UTF-8"?>
<entitymodel xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:noNamespaceSchemaLocation="http://ofbiz.apache.org/dtds/entitymodel.xsd">
	<title>Entities for openui5</title>
	<description>None</description>
	<copyright></copyright>
	<version></version>
	
<!--F-->
	<!--Facility-->
	<extend-entity entity-name="Facility">
		<field name="sequenceNum" type="numeric">
			<description>Facility序号</description>
		</field>
	</extend-entity>

	<!--FacilityContent-->
	<extend-entity entity-name="FacilityContent">
		<relation type="one-nofk" rel-entity-name="ContentAndMediaDataResource">
			<key-map field-name="contentId" rel-field-name="contentId"/>
		</relation>
	</extend-entity>
<!--P-->
	<!--Person-->
	<extend-entity entity-name="Person">
		<relation type="one-nofk" rel-entity-name="PartyAndContact">
			<key-map field-name="partyId"/>
		</relation>
	</extend-entity>
	<extend-entity entity-name="Party">
		<relation type="one-nofk" rel-entity-name="PartyAndContact">
			<key-map field-name="partyId" rel-field-name="partyId"/>
		</relation>
	</extend-entity>
	<extend-entity entity-name="UserLogin">
		<relation type="one-nofk" rel-entity-name="PartyAndContact">
			<key-map field-name="partyId"/>
		</relation>
		<relation type="many" title="From" rel-entity-name="PartyRelationship">
			<key-map field-name="partyId" rel-field-name="partyIdFrom"/>
		</relation>
		<relation type="many" title="To" rel-entity-name="PartyRelationship">
			<key-map field-name="partyId" rel-field-name="partyIdTo"/>
		</relation>
	</extend-entity>
	
	<extend-entity entity-name="Requirement">
		<field name="partyId" type="id"/>
		<relation type="one" fk-name="REQ_USERLOGIN" rel-entity-name="UserLogin">
			<key-map field-name="createdByUserLogin" rel-field-name="userLoginId"/>
		</relation>
		<relation type="one" fk-name="REQ_PARTYANDCONTACT" rel-entity-name="PartyAndContact">
			<key-map field-name="partyId"/>
		</relation>
	</extend-entity>
</entitymodel>
