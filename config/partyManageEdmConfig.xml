<ofbiz-edm xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://dev.odatalab.com/dtds/edmconfig.xsd" ImportGlobal="false">

    <EntityType Name="PartyAndContact" EntitySetName="Parties" AutoProperties="true" DraftEntityName="PartyAndContactDraft"
                Properties="partyId,partyTypeId,partyName,phoneMobile">
        <LineItem>
            <DataField Values="partyId,partyName,UserLogin/userLoginId,PartyRole/roleTypeId" Importance="High"/>
        </LineItem>
        <NavigationProperty Name="Person"/>
        <NavigationProperty Name="PartyGroup"/>
        <NavigationProperty Name="PartyRole"/>
        <NavigationProperty Name="UserLogin"/>
        <NavigationProperty Name="OrgPartyGroup"  IsCollection="false" Type="PartyGroup"
                            Relations="FromPartyRelationship(roleTypeIdFrom=ORGANIZATION_ROLE and roleTypeIdTo=Employee)/FromParty/PartyGroup"/>
    </EntityType>

    <EntityType Name="Person" EntitySetName="People"
                Properties="partyId,firstName,lastName,nickname,gender,birthDate,comments"/>

    <EntityType Name="PartyGroup" EntitySetName="PartyGroups"
                Properties="partyId,groupName,comments"/>

    <EntityType Name="PartyRole" EntitySetName="PartyRoles" AutoProperties="true"/>

    <EntityType Name="UserLogin" EntitySetName="UserLogins"
                Properties="userLoginId,enabled,partyId"/>

<!--    <EntityType Name="PartyRelationship" EntitySetName="PartyRelationships" AutoProperties="true">-->
<!--        <NavigationProperty Name="FromParty" Type="Party" Relations="FromParty"/>-->
<!--        <NavigationProperty Name="ToParty" Type="Party" Relations="FromParty"/>-->
<!--    </EntityType>-->

</ofbiz-edm>
