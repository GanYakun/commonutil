<ofbiz-edm xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://dev.odatalab.com/dtds/edmconfig.xsd" ImportGlobal="false">

    <EntityType Name="Party" EntitySetName="Parties" AutoProperties="true" DraftEntityName="PartyDraft">
        <HeaderInfo TypeName="Party Manage" TypeNamePlural="">
            <Title Path="partyId"/>
            <Description Path="partyName"/>
        </HeaderInfo>
        <NavigationProperty Name="Person"/>
        <NavigationProperty Name="PartyGroup"/>
        <NavigationProperty Name="PartyRole"/>
        <NavigationProperty Name="PrimaryPostalAddress" Type="ContactMech"
                            Relations="PartyContactMech/ContactMech(contactMechTypeId=POSTAL_ADDRESS)" IsCollection="false"/>
        <NavigationProperty Name="PrimaryTelecomNumber" Type="ContactMech"
                            Relations="PartyContactMech/ContactMech(contactMechTypeId=TELECOM_NUMBER)" IsCollection="false"/>
        <NavigationProperty Name="OrgPartyRelationship" Cascade="true" IsCollection="false" Type="PartyRelationship"
                            Relations="ToPartyRelationship(roleTypeIdFrom=ORGANIZATION_UNIT)"/>
        <NavigationProperty Name="CompanyPartyRelationship" IsCollection="false" Type="PartyRelationship"
                            Relations="ToPartyRelationship(roleTypeIdFrom=ORGANIZATION_ROLE)"/>
    </EntityType>

    <EntityType Name="PartyAndContact" EntitySetName="PartyAndContacts" AutoProperties="true" Orderby="-createdDate"
                DraftEntityName="PartyAndContactDraft" SearchOption="partyId,partyName,phoneMobile,externalId">
        <HeaderInfo TypeName="Party Manage" TypeNamePlural="">
            <Title Path="partyName"/>
            <Description Path="externalId"/>
        </HeaderInfo>
        <SelectionFields PropertyPath="partyName,phoneMobile,externalId"/>
        <LineItem>
            <DataField Values="partyName,PrimaryRole/RoleType/roleTypeId,phoneMobile,externalId"/>
        </LineItem>
        <Property Name="externalId" Required="true" Only="true"/>
        <Property Name="phoneMobile" Only="true" Required="true"/>
        <Property Name="partyName" Required="true"/>
        <RelAlias Name="PrimaryRole" Relations="PartyRole" Properties="roleTypeId"/>
        <NavigationProperty Name="Person"/>
        <NavigationProperty Name="PartyGroup"/>
        <NavigationProperty Name="PartyRole" />
        <NavigationProperty Name="UserLogin" IsCollection="false" Cascade="true"/>
        <NavigationProperty Name="PrimaryRole" Relations="PartyRole" IsCollection="false" Type="PartyRole"/>
        <NavigationProperty Name="OrgPartyRelationship" IsCollection="false" Type="PartyRelationship"
                            Relations="ToPartyRelationship(roleTypeIdFrom=ORGANIZATION_UNIT)"/>
        <NavigationProperty Name="CompanyPartyRelationship" IsCollection="false" Type="PartyRelationship"
                            Relations="ToPartyRelationship(roleTypeIdFrom=ORGANIZATION_ROLE)"/>
        <NavigationProperty Name="SecurityPermission" Type="SecurityPermission" IsCollection="true"
                            Relations="PartyRole/RoleType/RoleTypeSecurityPermission/SecurityPermission"/>
        <Action Name="PartyAndContactNewAction" IsBound="true" EntitySetPath="partyAndContact"
                OfbizService="com.dpbird.odata.services.ProcessorServices.stickySessionNewAction"
                StickySession="true">
            <Parameter Name="partyAndContact" Type="PartyAndContact" Nullable="false" IsCollection="true" />
            <ReturnType Type="PartyAndContact" />
        </Action>
        <Action Name="PartyAndContactEditAction" IsBound="true" EntitySetPath="partyAndContact"
                OfbizService="com.dpbird.odata.services.ProcessorServices.stickySessionEditAction"
                StickySession="true">
            <Parameter Name="partyAndContact" Type="PartyAndContact" Nullable="false" IsCollection="false"/>
            <ReturnType Type="PartyAndContact"/>
        </Action>
        <Action Name="PartyAndContactSaveAction" IsBound="true" EntitySetPath="partyAndContact"
                OfbizService="com.dpbird.odata.services.ProcessorServices.stickySessionSaveAction"
                StickySession="true">
            <Parameter Name="partyAndContact" Type="PartyAndContact" Nullable="false" IsCollection="false" />
            <ReturnType Type="PartyAndContact" />
        </Action>
    </EntityType>

    <EntityType Name="Person" EntitySetName="People" Properties="partyId,firstName,lastName,nickname,gender,birthDate,comments"/>

    <EntityType Name="PartyRelationship" EntitySetName="PartyRelationships" DraftEntityName="PartyRelationshipDraft"
                Properties="partyRelationshipId,partyIdFrom,partyIdTo,roleTypeIdFrom,roleTypeIdTo,fromDate" >
        <Property Name="partyIdFrom" Required="true">
            <Text Path="FromParty/partyName" TextArrangement="TextOnly"/>
            <ValueList CollectionPath="Parties" Label=""/>
        </Property>
        <Property Name="partyIdTo">
            <Text Path="ToParty/partyName" TextArrangement="TextOnly"/>
        </Property>
        <NavigationProperty Name="FromParty" ReadOnly="true"/>
        <NavigationProperty Name="ToParty" ReadOnly="true"/>
    </EntityType>

    <EntityType Name="PartyGroup" EntitySetName="PartyGroups"
                Properties="groupName,comments">
        <Property Name="partyId">
            <Text Path="groupName" TextArrangement="TextOnly"/>
        </Property>
    </EntityType>

    <EntityType Name="PartyRole" EntitySetName="PartyRoles" DraftEntityName="PartyRoleDraft">
        <Property Name="partyId" Computed="true"/>
        <Property Name="roleTypeId" />
        <NavigationProperty Name="RoleType"/>
    </EntityType>

    <EntityType Name="CompanyPartyRole" OfbizEntity="PartyRole" EntitySetName="CompanyPartyRoles" DraftEntityName="CompanyPartyRoleDraft">
        <Property Name="partyId" Computed="true"/>
        <Property Name="roleTypeId" />
        <NavigationProperty Name="RoleType"/>
    </EntityType>

    <EntityType Name="RoleType" AutoProperties="true" EntitySetName="RoleTypes">
        <Property Name="roleTypeId">
            <Text Path="description" TextArrangement="TextFirst"/>
        </Property>
        <ValueList CollectionPath="RoleTypes" WithFixedValues="true" Label="{@i18n>RoleType}"/>
    </EntityType>

    <EntityType Name="UserLogin" EntitySetName="UserLogins" AutoProperties="true" DraftEntityName="UserLoginDraft">
        <NavigationProperty Name="UserLoginSecurityGroup"/>
    </EntityType>

    <EntityType Name="UserLoginSecurityGroup" EntitySetName="UserLoginSecurityGroups" AutoProperties="true">
        <NavigationProperty Name="SecurityGroupPermission"/>
    </EntityType>
    <EntityType Name="SecurityGroupPermission" EntitySetName="SecurityGroupPermission" AutoProperties="true"/>
    <EntityType Name="SecurityPermission" EntitySetName="SecurityPermissions" AutoProperties="true" SearchOption="permissionId,description">
        <LineItem Qualifier="permissionList">
            <DataField Values="permissionId,description" Importance="High"/>
        </LineItem>
    </EntityType>
    <EntityType Name="RoleTypeSecurityPermission" EntitySetName="RoleTypeSecurityPermissions" AutoProperties="true">
        <NavigationProperty Name="SecurityPermission"/>
    </EntityType>
    <EntityType Name="ContactMech" EntitySetName="ContactMechs" AutoProperties="true">
        <NavigationProperty Name="TelecomNumber"/>
        <NavigationProperty Name="PostalAddress"/>
    </EntityType>

    <EntityType Name="TelecomNumber" EntitySetName="TelecomNumbers" AutoProperties="true"/>
    <EntityType Name="PostalAddress" EntitySetName="PostalAddresses" AutoProperties="true"/>

    <Action Name="DiscardAction"/>

    <EntityContainer>
        <ActionImport Name="DiscardAction" Action="DiscardAction" />
    </EntityContainer>

</ofbiz-edm>
