<ofbiz-edm xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:noNamespaceSchemaLocation="https://dev.odatalab.com/dtds/edmconfig.xsd" ImportGlobal="false">
    <!-- 返回用户自选参数 -->
    <ComplexType Name="ApproverData">
        <Property Name="nodeId" Type="Edm.Decimal"/>
        <Property Name="nodeName" Type="String"/>
        <Property Name="selectList" Type="String"/>
    </ComplexType>
    <!-- 用户返回当前正在进行的节点 -->
    <ComplexType Name="ActiveData">
        <Property Name="processId" Type="String"/>
        <Property Name="nodeId" Type="Edm.Decimal"/>
    </ComplexType>
    <!--=====================================     业务主对象EntityType definition Begin    =====================================-->
    <!--请假申请-->
    <!--需要将EntityType的名字改成LeaveApply-->
    <EntityType Name="LeaveApproval" OfbizEntity="EmplLeave" EntitySetName="LeaveApprovals" AutoProperties="true" Orderby="-fromDate"
                Handler="component://bfcommon/groovyScripts/businessManage/LeaveApproval.groovy"
                EntityCondition="partyId=${userLogin.partyId}">
        <SelectionFields PropertyPath="emplLeaveReasonTypeId,description,fromDate,thruDate,statusId"/>
        <Property Name="isHiddenSubmitApproval" Type="Boolean"/>
        <Property Name="isHiddenCancelApproval" Type="Boolean"/>
        <Property Name="emplLeaveId" Computed="true"/>
        <Property Name="leaveTypeId">
            <Text Path="LeaveType/description" TextArrangement="TextOnly"/>
        </Property>
        <Property Name="partyId" Required="true" FieldControl="Mandatory">
            <Text Path="LeaveMember/partyName" TextArrangement="TextOnly"/>
        </Property>
        <Property Name="fromDate" Required="true" FieldControl="Mandatory"/>
        <Property Name="thruDate" Required="true" FieldControl="Mandatory"/>
        <Property Name="description" Required="true" FieldControl="Mandatory" MultiLineText="true"/>
        <Property Name="emplLeaveReasonTypeId" Required="true" FieldControl="Mandatory">
            <Text Path="LeaveReasonType/description" TextArrangement="TextOnly"/>
        </Property>
        <Property Name="statusId" DefaultValue="APPROVAL_CREATED">
            <Text Path="LeaveStatus/description" TextArrangement="TextOnly"/>
        </Property>
        <Function Name="GetApproverData" OfbizService="com.banfftech.event.ApprovalEvent.getApproverData"
                  IsBound="true">
            <Parameter Name="leaveApproval" Type="LeaveApproval" Nullable="false" IsCollection="false"/>
            <ReturnType Type="ApproverData" IsCollection="true"/>
        </Function>
        <Action Name="SubmitApproval" IsBound="true" OfbizService="com.banfftech.event.ApprovalEvent.submitApproval">
            <Parameter Name="leaveApproval" Type="LeaveApproval" Nullable="false" IsCollection="false"/>
            <Parameter Name="approverData" Type="String" Nullable="true" IsCollection="false"/>
        </Action>
        <Action Name="CancelApproval" IsBound="true" OfbizService="com.banfftech.event.ApprovalEvent.cancelApproval">
            <Parameter Name="leaveApproval" Type="LeaveApproval" Nullable="false" IsCollection="false"/>
        </Action>
        <Action Name="ViewApproval" IsBound="true" OfbizService="com.banfftech.event.ApprovalEvent.viewApproval">
            <Parameter Name="leaveApproval" Type="LeaveApproval" Nullable="false" IsCollection="false"/>
            <ReturnType Type="ActiveData" Nullable="true"/>
        </Action>
        <FieldGroup Qualifier="BaseInfo" Label="基本信息">
            <DataField Values="emplLeaveReasonTypeId,fromDate,thruDate,description"
                       Importance="High"/>
        </FieldGroup>
        <FieldGroup Qualifier="ApplicantInformation" Label="申请人信息">
            <DataField Values="partyId,LeaveMember/externalId,LeaveMember/phoneMobile,LeaveMember/Department/partyName"
                       Importance="High"/>
        </FieldGroup>
        <LineItem>
            <DataField Values="partyId,emplLeaveReasonTypeId,description,fromDate,thruDate,statusId,LeaveMember/externalId,LeaveMember/phoneMobile,LeaveMember/Department/partyName"
                       Importance="High"/>
            <DataFieldForAction Label="查看进度" Importance="High" Action="ViewApproval" Hidden="isHiddenCancelApproval"
                                Inline="true" InvocationGrouping="Isolated" Criticality="Positive"/>
        </LineItem>
        <NavigationProperty Name="LeaveType" Relations="EmplLeaveType" Type="LeaveType"
                            IsCollection="false"/>
        <NavigationProperty Name="LeaveReasonType" Relations="EmplLeaveReasonType" Type="LeaveReasonType"
                            IsCollection="false"/>
        <NavigationProperty Name="LeaveStatus" Relations="CurrentStatusItem" Type="LeaveStatus"
                            IsCollection="false"/>
        <NavigationProperty Name="LeaveMember" Relations="Party/PartyAndContact" Type="Member"
                            IsCollection="false"/>
        <!--关联审批记录-->
        <NavigationProperty Name="ApprovalRecord" Relations="WorkFlowMember(memberEntityName=EmplLeave)/WorkEffort/Approval" Type="ApprovalRecord"
                            IsCollection="true"/>
    </EntityType>

    <!--=====================================     业务主对象EntityType definition End    =====================================-->

    
    <!--=====================================     业务子对象EntityType definition End    =====================================-->
    <!--审批-->
    <EntityType Name="ApprovalRecord" OfbizEntity="Approval" EntitySetName="ApprovalRecords" AutoProperties="true">
        <RelAlias Name="DBEntity" Relations="TopWorkEffort/ParentWorkEffort/MainProcess/DBEntity"/>
        <Property Name="dbEntityName" RelAlias="DBEntity" Field="dbEntityName"/>
        <Property Name="statusId">
            <Text Path="ApprovalStatusItem/description" TextArrangement="TextOnly"/>
        </Property>
        <Property Name="mannerEnumId">
            <Text Path="Via/description" TextArrangement="TextOnly"/>
        </Property>
        <Property Name="partyId">
            <Text Path="Member/partyName" TextArrangement="TextOnly"/>
        </Property>
        <LineItem Qualifier="RecordApproval">
            <DataField
                    Values="workEffortName,fromDate,thruDate,partyId,comments,mannerEnumId,statusId"
                    Importance="High"/>
        </LineItem>
        <NavigationProperty Name="ApprovalStatusItem" Relations="ApprovalStatusItem" Type="ApprovalStatusItem"
                            IsCollection="false"/>
        <!--关联审批通过枚举-->
        <NavigationProperty Name="Via" Relations="MannerEnumeration" Type="Via" IsCollection="false"/>
        <NavigationProperty Name="Member" Relations="PartyAndContact" Type="Member"/>
    </EntityType>
    <!--请假类型-->
    <EntityType Name="LeaveType" OfbizEntity="EmplLeaveType" EntitySetName="LeaveTypes" AutoProperties="true">
        <ValueList CollectionPath="LeaveTypes" WithFixedValues="true"/>
        <Property Name="leaveTypeId">
            <Text Path="description" TextArrangement="TextOnly"/>
        </Property>
    </EntityType>

    <!--请假原因-->
    <EntityType Name="LeaveReasonType" OfbizEntity="EmplLeaveReasonType" EntitySetName="LeaveReasonTypes"
                AutoProperties="true">
        <ValueList CollectionPath="LeaveReasonTypes" WithFixedValues="true"/>
        <Property Name="emplLeaveReasonTypeId">
            <Text Path="description" TextArrangement="TextOnly"/>
        </Property>
    </EntityType>

    <!--请假状态-->
    <EntityType Name="LeaveStatus" OfbizEntity="StatusItem" EntitySetName="LeaveStatuses"
                EntityCondition="statusTypeId=APPROVAL" AutoProperties="true">
        <ValueList CollectionPath="LeaveStatuses" WithFixedValues="true"/>
        <Property Name="statusId">
            <Text Path="description" TextArrangement="TextOnly"/>
        </Property>
    </EntityType>
    <!--=====================================     业务子对象EntityType definition End    =====================================-->

    <!--=====================================     其他对象EntityType definition End    =====================================-->
    <EntityType Name="Member" OfbizEntity="PartyAndContact" EntitySetName="Members" OfbizType="partyTypeId=PERSON"
                EntityCondition="PartyRole/roleTypeId=ORD_EMPLOYEE"
                AutoProperties="true">
        <RelAlias Name="Person" Relations="Person"/>
        <Property Name="gender" RelAlias="Person" Field="gender" FieldControl="Mandatory" Required="true">
            <Text Path="GenderEnumeration/description" TextArrangement="TextOnly"/>
        </Property>
        <Property Name="birthDate" RelAlias="Person" Field="birthDate" FieldControl="Mandatory" Required="true"/>
        <Property Name="nickname" RelAlias="Person" Field="nickname" FieldControl="Mandatory" Required="true"/>
        <Property Name="partyTypeId" DefaultValue="PERSON"/>
        <Property Name="isManager" Type="Boolean"/>
        <Property Name="isNotManager" Type="Boolean"/>
        <Property Name="partyId" Immutable="true">
            <Text Path="partyName" TextArrangement="TextOnly"/>
        </Property>
        <NavigationProperty Name="Department" Type="Department"
                            Relations="ToPartyRelationship(roleTypeIdTo=ORD_EMPLOYEE)/FromPartyAndPartyGroup"
                            IsCollection="false"/>
        <NavigationProperty Name="GenderEnumeration" Type="Gender"
                            Relations="Person/GenderEnumeration"/>
    </EntityType>

    <EntityType Name="Department" OfbizEntity="PartyAndPartyGroup" EntitySetName="Departments"
                AutoProperties="true">
    </EntityType>

    <!--性别-->
    <EntityType Name="Gender" OfbizEntity="Enumeration" EntitySetName="Genders"
                EntityCondition="enumTypeId=GENDER_ENUM_TYPE"
                AutoProperties="true">
        <Property Name="enumId">
            <Text Path="description" TextArrangement="TextOnly"/>
        </Property>
        <ValueList WithFixedValues="true" CollectionPath="Genders"/>
    </EntityType>

    <EntityType Name="ApprovalStatusItem" OfbizEntity="StatusItem" EntitySetName="ApprovalStatusItem"
                AutoProperties="true" EntityCondition="statusTypeId=WORKFLOW_STATUS"/>


    <!--审批通过方式枚举-->
    <EntityType Name="Via" OfbizEntity="Enumeration" EntitySetName="Vias" EntityCondition="enumTypeId=PASS_MANNER"
                AutoProperties="true">
    </EntityType>


    <!--=====================================     其他对象EntityType definition End    =====================================-->
</ofbiz-edm>
